<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tablo4g" name="Tablo (4th Gen)" version="1.0.3" provider-name="community">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests" version="2.22.0"/>
    <import addon="pvr.iptvsimple" optional="true"/>
    <import addon="inputstream.adaptive" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context.py">
        <label>30020</label>
        <visible>[Window.IsActive(tvguide) | Window.IsActive(tvsearch)] + !String.IsEmpty(ListItem.Title)</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Unofficial Tablo 4th Gen DVR client</summary>
    <description lang="en_GB">Live TV and guide through IPTV Simple Client, plus recordings, scheduling and status for Tablo 4th Gen DVRs. Unofficial; not affiliated with Nuvyyo/Tablo. A Tablo firmware update may break it.</description>
    <disclaimer lang="en_GB">Uses the same undocumented API as the official Tablo apps.</disclaimer>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
